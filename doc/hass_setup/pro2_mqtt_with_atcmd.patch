diff --git a/component/soc/8735b/misc/driver/mqtt/atcmd_mqtt.c b/component/soc/8735b/misc/driver/mqtt/atcmd_mqtt.c
new file mode 100644
index 00000000..e336f62a
--- /dev/null
+++ b/component/soc/8735b/misc/driver/mqtt/atcmd_mqtt.c
@@ -0,0 +1,122 @@
+#include "FreeRTOS.h"
+#include "task.h"
+#include "semphr.h"
+#include "atcmd_mqtt.h"
+#include "log_service.h"
+#include "stdio_port_func.h"
+
+// 私有變數
+static MQTTClient *mqtt_client = NULL;
+static const char *mqtt_response_topic = NULL;
+static char response_buffer[1024];
+static int response_len = 0;
+static SemaphoreHandle_t response_mutex = NULL;
+static int atcmd_mqtt_enabled = 0;
+
+// AT command 處理相關
+extern char log_buf[LOG_SERVICE_BUFLEN];
+extern xSemaphoreHandle log_rx_interrupt_sema;
+
+// MQTT 輸出重導向
+static unsigned atcmd_mqtt_write_buffer(unsigned fd, const void *buf, unsigned len)
+{
+	if (buf && len > 0 && response_mutex) {
+		xSemaphoreTake(response_mutex, portMAX_DELAY);
+
+		int copy_size = len;
+		if (response_len + copy_size > sizeof(response_buffer) - 1) {
+			copy_size = sizeof(response_buffer) - 1 - response_len;
+		}
+
+		if (copy_size > 0) {
+			memcpy(&response_buffer[response_len], buf, copy_size);
+			response_len += copy_size;
+		}
+
+		xSemaphoreGive(response_mutex);
+	}
+	return len;
+}
+
+static unsigned atcmd_mqtt_read_buffer(unsigned fd, void *buf, unsigned len)
+{
+	return 0;
+}
+
+// 處理 AT command
+int atcmd_mqtt_process(const char *cmd, int cmd_len, char *response, int max_resp_len)
+{
+	if (!atcmd_mqtt_enabled || !cmd || cmd_len <= 0) {
+		return -1;
+	}
+
+	mqtt_printf(MQTT_INFO, "Processing AT command: %.*s\n", cmd_len, cmd);
+
+	// 清空回應 buffer
+	xSemaphoreTake(response_mutex, portMAX_DELAY);
+	response_len = 0;
+	memset(response_buffer, 0, sizeof(response_buffer));
+	xSemaphoreGive(response_mutex);
+
+	// 複製命令到 log_buf
+	if (cmd_len >= LOG_SERVICE_BUFLEN) {
+		cmd_len = LOG_SERVICE_BUFLEN - 1;
+	}
+	memset(log_buf, '\0', LOG_SERVICE_BUFLEN);
+	memcpy(log_buf, cmd, cmd_len);
+
+	// 觸發 AT command 處理
+	if (log_rx_interrupt_sema != NULL) {
+		rtw_up_sema((_sema *)&log_rx_interrupt_sema);
+	}
+
+	// 等待處理完成（可能需要根據不同命令調整時間）
+	vTaskDelay(300);
+
+	// 複製回應
+	xSemaphoreTake(response_mutex, portMAX_DELAY);
+	int ret_len = response_len;
+	if (response && max_resp_len > 0) {
+		int copy_len = ret_len > max_resp_len - 1 ? max_resp_len - 1 : ret_len;
+		memcpy(response, response_buffer, copy_len);
+		response[copy_len] = '\0';
+	}
+	xSemaphoreGive(response_mutex);
+
+	mqtt_printf(MQTT_INFO, "AT command response length: %d\n", ret_len);
+
+	return ret_len;
+}
+
+// 設定 MQTT client
+void atcmd_mqtt_set_client(MQTTClient *client, const char *response_topic)
+{
+	mqtt_client = client;
+	mqtt_response_topic = response_topic;
+}
+
+// 初始化
+void atcmd_mqtt_init(void)
+{
+	if (!atcmd_mqtt_enabled) {
+		response_mutex = xSemaphoreCreateMutex();
+		atcmd_mqtt_enabled = 1;
+		// 保存原始 stdio
+		//extern void remote_stdio_get(void **read_cb, void **write_cb);
+		extern void remote_stdio_init(void *read_cb, void *write_cb);
+
+		// 將遠端輸出重導向到 MQTT
+		remote_stdio_init(atcmd_mqtt_read_buffer, atcmd_mqtt_write_buffer);
+		mqtt_printf(MQTT_INFO, "AT command over MQTT service initialized\n");
+	}
+}
+
+// 關閉服務
+void atcmd_mqtt_deinit(void)
+{
+	atcmd_mqtt_enabled = 0;
+	if (response_mutex) {
+		vSemaphoreDelete(response_mutex);
+		response_mutex = NULL;
+	}
+}
